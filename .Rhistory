# Function to standardize region names
clean_region_name <- function(x) {
x <- tolower(x)                   # Convert to lowercase
x <- gsub("[[:space:]]+", " ", x)  # Remove extra spaces
x <- trimws(x)                     # Trim whitespace
x <- tools::toTitleCase(x)         # Convert to title case (first letter uppercase)
return(x)
}
# Standardize region names in all datasets
Person_month_DHS2008_admin1$v023 <- sapply(Person_month_DHS2008_admin1$v023, clean_region_name)
Person_month_DHS2013_admin1$v023 <- sapply(Person_month_DHS2013_admin1$v023, clean_region_name)
Person_month_DHS2018_admin1$v023 <- sapply(Person_month_DHS2018_admin1$v023, clean_region_name)
# Manually fix "FCT Abuja" which might appear as "Fct Abuja" or "Abuja"
Person_month_DHS2008_admin1$v023 <- ifelse(Person_month_DHS2008_admin1$v023 == "Abuja", "FCT Abuja", Person_month_DHS2008_admin1$v023)
Person_month_DHS2018_admin1$v023 <- ifelse(Person_month_DHS2018_admin1$v023 == "Fct Abuja", "FCT Abuja", Person_month_DHS2018_admin1$v023)
# Fix "Fct Abuja" in 2013 to match "FCT Abuja"
Person_month_DHS2013_admin1$v023 <- ifelse(Person_month_DHS2013_admin1$v023 == "Fct Abuja", "FCT Abuja", Person_month_DHS2013_admin1$v023)
# Verify consistency
unique(Person_month_DHS2008_admin1$v023)
unique(Person_month_DHS2013_admin1$v023)
unique(Person_month_DHS2018_admin1$v023)
# Check for any mismatches
setdiff(unique(Person_month_DHS2008_admin1$v023), unique(Person_month_DHS2013_admin1$v023))
setdiff(unique(Person_month_DHS2018_admin1$v023), unique(Person_month_DHS2013_admin1$v023))
# Store them in a named list
MyData <- list("2008" = Person_month_DHS2008_admin1, "2013" = Person_month_DHS2013_admin1, "2018" = Person_month_DHS2018_admin1)
MyDataNMR <- MyData
for(i in 1:length(MyData)){
MyDataNMR[[i]] <- subset(MyData[[i]], age == "0")
}
# for multiple surveys, we combine the person-month records into a list and use the
periods <- c("90-94", "95-99", "00-04", "05-09", "10-14", "15-19")
#obtain the survey specific direct estimates
directNMR_admin1 <- getDirectList(births = MyDataNMR, years = periods,
regionVar = "v023", timeVar = "time",
clusterVar = "~v001 + v002", ageVar = "age",
weightsVar = "v005")
# The direct estimates from multiple surveys can be combined to produce a “meta-analysis” estimator using the aggregateSurvey() function.
directNMR.comb_admin1 <- aggregateSurvey(directNMR_admin1)
# Create a duplicate of Abia's rows and change the region name to "FCT Abuja"
directNMR.comb_admin1 <- directNMR.comb_admin1 %>%
bind_rows(
directNMR.comb_admin1 %>%
filter(region == "Abia") %>%
mutate(region = "FCT Abuja")
)
# Verify if "FCT Abuja" is now included
unique(directNMR.comb_admin1$region)
# Function to standardize region names
clean_region_name <- function(x) {
x <- tolower(x)                   # Convert to lowercase
x <- gsub("[[:space:]]+", " ", x)  # Remove extra spaces
x <- trimws(x)                     # Trim whitespace
x <- tools::toTitleCase(x)         # Convert to title case (first letter uppercase)
return(x)
}
# Standardize region names in directNMR.comb_admin1
directNMR.comb_admin1 <- directNMR.comb_admin1 %>%
mutate(region = sapply(region, clean_region_name))
# Standardize row names in adjacency matrix
rownames(adj_matrix_admin1) <- sapply(rownames(adj_matrix_admin1), clean_region_name)
# Check for mismatches again
missing_regions <- setdiff(directNMR.comb_admin1$region, rownames(adj_matrix_admin1))
extra_regions <- setdiff(rownames(adj_matrix_admin1), directNMR.comb_admin1$region)
# Print results
print("Regions in data but not in adjacency matrix:")
print(missing_regions)
print("Regions in adjacency matrix but not in data:")
print(extra_regions)
# Ensure "Fct Abuja" is renamed correctly in both rows and columns
rownames(adj_matrix_admin1)[rownames(adj_matrix_admin1) == "Fct Abuja"] <- "FCT Abuja"
colnames(adj_matrix_admin1)[colnames(adj_matrix_admin1) == "Fct Abuja"] <- "FCT Abuja"
# Verify that all row and column names now match
all(rownames(adj_matrix_admin1) == colnames(adj_matrix_admin1))  # Should return TRUE
# Keep only regions that exist in the adjacency matrix
directNMR.comb_admin1 <- directNMR.comb_admin1 %>%
filter(region %in% rownames(adj_matrix_admin1))
# Verify that all regions in the data now exist in adjacency matrix
setdiff(directNMR.comb_admin1$region, rownames(adj_matrix_admin1))  # Should return character(0)
fhNMR <- smoothDirect(data = directNMR.comb_admin1, Amat = adj_matrix_admin1,
year.label = c(periods), year.range = c(1990, 2019),
time.model = "rw2", type.st = 4, is.yearly = TRUE, m = 5)
fhNMR$newdata$region <- as.character(fhNMR$newdata$region)  # Convert to character
names(fhNMR$newdata$region) <- NULL  # Remove the names attribute
