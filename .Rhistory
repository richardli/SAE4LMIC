# Store them in a named list
MyData_FH_DHS <- list("2003" = Person_month_DHS2003, "2008" = Person_month_DHS2008, "2013" = Person_month_DHS2013, "2018" = Person_month_DHS2018)
MyDataNMR_FH_DHS <- MyData_FH_DHS
for(i in 1:length(MyData_FH_DHS)){
MyDataNMR_FH_DHS[[i]] <- subset(MyData_FH_DHS[[i]], age == "0")
}
# for multiple surveys, we combine the person-month records into a list and use the
periods <- c("90-94", "95-99", "00-04", "05-09", "10-14", "15-19")
#obtain the survey specific direct estimates
directNMR <- getDirectList(births = MyDataNMR_FH_DHS, years = periods,
regionVar = "v024", timeVar = "time",
clusterVar = "~v001 + v002", ageVar = "age",
weightsVar = "v005")
# The direct estimates from multiple surveys can be combined to produce a “meta-analysis” estimator using the aggregateSurvey() function.
directNMR.comb_DHS_region <- aggregateSurvey(directNMR)
region_correction <- c("north central" = "North Central",
"north east" = "North East",
"north west" = "North West",
"south east" = "South East",
"south south" = "South South",
"south west" = "South West")
directNMR.comb_DHS_region$region <- recode(directNMR.comb_DHS_region$region, !!!region_correction)
fhNMR_DHS_region <- smoothDirect(data = directNMR.comb_DHS_region, Amat = adj_matrix,
year.label = c(periods), year.range = c(1990, 2019),
time.model = "rw2", type.st = 4, is.yearly = TRUE, m = 5)
est.NMR_DHS_region <- getSmoothed(fhNMR_DHS_region, CI = 0.95)
g3 <- plot(est.NMR_DHS_region, per1000 = TRUE) + ggtitle("NMR")
g4 <- plot(est.NMR_DHS_region, per1000 = TRUE, plot.CI=TRUE) + facet_wrap(~region)
g3
g4
