geo <- sf::st_read(file_path_geo)
cluster.info <- surveyPrev::clusterInfo(geo = geo,
poly.adm1 = poly.adm1,
poly.adm2 = poly.adm2,
by.adm1 = "NAME_1",
by.adm2 = "NAME_2",
map=TRUE)
