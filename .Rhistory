get_val <- function(country, ind, yr) {
x <- res_adm0_store[[country]][[ind]][[as.character(yr)]]
if (is.null(x)) return(NA_real_)
out <- tryCatch(x$res.natl$direct.est, error = function(e) NA_real_)
as.numeric(out)
}
rows <- lapply(indicatorlist, function(ind) {
# label: Full definition if available, otherwise the ID
label <- infolist$Description[match(ind, infolist$ID)]
if (length(label) == 0 || is.na(label)) label <- ind
vals <- sapply(years, function(yr) get_val(country, ind, yr))
data.frame(
Indicator = label,
t(vals),
check.names = FALSE
)
})
tab <- do.call(rbind, rows)
# name the year columns like the screenshot
names(tab)[-1] <- paste("DHS", years)
# format as percentages with 1 decimal (keep NA if missing)
fmt <- function(x) ifelse(is.na(x), NA, round(100 * x, 1))
tab[-1] <- lapply(tab[-1], fmt)
# optional: order rows by Indicator
tab <- tab[order(tab$Indicator), ]
write.csv(tab, file = file.path(source_path,"results", country, "National.csv"), row.names = FALSE)
}
