.libPaths()                     # see the library search order
# Try to remove via R first:
suppressWarnings(remove.packages("surveyPrev", lib = .libPaths()))
# Manually nuke any leftover dirs & 00LOCKs across all lib paths:
for (p in .libPaths()) {
d <- file.path(p, "surveyPrev")
if (dir.exists(d)) unlink(d, recursive = TRUE, force = TRUE)
lock <- list.files(p, pattern = "^00LOCK[-.].*surveyPrev", full.names = TRUE)
if (length(lock)) unlink(lock, recursive = TRUE, force = TRUE)
}
