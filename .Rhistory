library(dplyr)
library(haven)
library(labelled)
convert_MICS_to_DHS_admin1 <- function(data) {
# Define the exact mapping from MICS HH7 labels to DHS v023 values
mics_to_dhs_map <- c(
"Benue" = 18, "FCT Abuja" = 14, "Kogi" = 19, "Kwara" = 20, "Nasarawa" = 15, "Niger" = 13, "Plateau" = 16,
"Adamawa" = 7, "Bauchi" = 9, "Borno" = 6, "Gombe" = 8, "Taraba" = 17, "Yobe" = 5,
"Jigawa" = 4, "Kaduna" = 11, "Kano" = 10, "Katsina" = 3, "Kebbi" = 12, "Sokoto" = 1, "Zamfara" = 2,
"Abia" = 31, "Anambra" = 26, "Ebonyi" = 28, "Enugu" = 27, "Imo" = 32,
"Akwa Ibom" = 30, "Bayelsa" = 34, "Cross River" = 29, "Delta" = 35, "Edo" = 25, "Rivers" = 33,
"Ekiti" = 23, "Lagos" = 36, "Ogun" = 37, "Ondo" = 24, "Osun" = 22, "Oyo" = 21
)
# Define the labelled structure for v023
v023_labels <- c(
"Sokoto" = 1, "Zamfara" = 2, "Katsina" = 3, "Jigawa" = 4, "Yobe" = 5,
"Borno" = 6, "Adamawa" = 7, "Gombe" = 8, "Bauchi" = 9, "Kano" = 10,
"Kaduna" = 11, "Kebbi" = 12, "Niger" = 13, "FCT Abuja" = 14, "Nasarawa" = 15,
"Plateau" = 16, "Taraba" = 17, "Benue" = 18, "Kogi" = 19, "Kwara" = 20,
"Oyo" = 21, "Osun" = 22, "Ekiti" = 23, "Ondo" = 24, "Edo" = 25,
"Anambra" = 26, "Enugu" = 27, "Ebonyi" = 28, "Cross River" = 29,
"Akwa Ibom" = 30, "Abia" = 31, "Imo" = 32, "Rivers" = 33, "Bayelsa" = 34,
"Delta" = 35, "Lagos" = 36, "Ogun" = 37
)
# Convert HH7 labels to match DHS v023 with labelled values
if ("HH7" %in% colnames(data)) {
data <- data %>%
dplyr::mutate(
HH7_label = haven::as_factor(HH7),  # Convert factor to character labels
v023_unlabelled = as.numeric(unname(mics_to_dhs_map[HH7_label])),  # Convert to DHS code
v023 = labelled::labelled(v023_unlabelled, v023_labels),  # Assign labelled format
v023 = haven::labelled_spss(v023, labels = v023_labels, label = "Admin1 regions") # Stata-like format
) %>%
dplyr::select(-HH7_label, -v023_unlabelled)  # Drop intermediate columns
}
# Check for the existence of the region variable
region_var <- if ("zone" %in% colnames(data)) "zone" else if ("Zone" %in% colnames(data)) "Zone" else NA
data_converted <- data %>%
dplyr::mutate(
caseid = as.character(paste0(HH1, "_", HH2)),
v001 = as.numeric(HH1),  # Cluster number
v002 = as.numeric(HH2),  # Household number
v004 = as.numeric(HH1),  # Ultimate area unit (same as cluster number)
v005 = as.numeric(wmweight),  # Sample weight
v024 = if (!is.na(region_var)) as.character(haven::as_factor(data[[region_var]])) else NA,  # Convert labelled to character if available
v025 = as.character(haven::as_factor(HH6)),  # Urban/Rural as character
b3 = as.numeric(BH4C),  # Date of birth
b7 = as.numeric(BH9C),  # Age at death in months
b5 = factor(ifelse(is.na(BH9C), "yes", "no"), levels = c("no", "yes")),  # Alive status as factor
v008 = as.numeric(WDOI),  # Date of interview
v021 = as.numeric(HH1),  # Use cluster number as PSU (if no direct equivalent in MICS)
v022 = as.numeric(HH1),  # Placeholder for sample strata (check if there's a better equivalent)
v139 = as.numeric(NA),  # Birth order (check if available in MICS data)
bidx = as.numeric(NA)  # Birth index (check if available in MICS data)
) %>%
dplyr::select(caseid, v001, v002, v004, v005, v024, v025, b3, b7, b5, v008, v021, v022, v023, v139, bidx)
return(data_converted)
}
bh_2016_dhs <- convert_MICS_to_DHS_admin1(bh_2016)
bh_2021_dhs <- convert_MICS_to_DHS_admin1(bh_2021)
Person_month_MICS2016 <- getBirths(
data = bh_2016_dhs,
surveyyear = 2016,
month.cut = c(1),
year.cut = seq(1990, 2020, by = 5),
strata = c("v024","v025"),
compact = FALSE
)
Person_month_MICS2021 <- getBirths(
data = bh_2021_dhs,
surveyyear = 2021,
month.cut = c(1),
year.cut = seq(1990, 2020, by = 5),
strata = c("v024","v025"),
compact = FALSE
)
# Function to convert labelled v023 to character format like DHS
convert_v023_to_character <- function(data) {
if ("v023" %in% colnames(data)) {
data <- data %>%
mutate(v023 = as.character(haven::as_factor(v023)))  # Convert labelled numeric to character labels
}
return(data)
}
# Apply conversion to MICS datasets
Person_month_MICS2016 <- convert_v023_to_character(Person_month_MICS2016)
Person_month_MICS2021 <- convert_v023_to_character(Person_month_MICS2021)
# # Verify consistency
# str(Person_month_MICS2016$v023)
# str(Person_month_MICS2021$v023)
# Store them in a named list
MyData <- list("2008" = Person_month_DHS2008_admin1, "2013" = Person_month_DHS2013_admin1, "2018" = Person_month_DHS2018_admin1, "2016" = Person_month_MICS2016, "2021" = Person_month_MICS2021)
MyDataNMR <- MyData
for(i in 1:length(MyData)){
MyDataNMR[[i]] <- subset(MyData[[i]], age == "0")
}
# for multiple surveys, we combine the person-month records into a list and use the
periods <- c("90-94", "95-99", "00-04", "05-09", "10-14", "15-19")
#obtain the survey specific direct estimates
directNMR <- getDirectList(births = MyDataNMR, years = periods,
regionVar = "v023", timeVar = "time",
clusterVar = "~v001 + v002", ageVar = "age",
weightsVar = "v005")
