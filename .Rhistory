library(dplyr)
library(haven)
library(stringr)
#data modification for admin1 level
# have to drop DHS 2003
# DHS 2008, can change v024 to v023, but there is a national level in the v023
# DHS 2013
# Extract the labels from the column
labels_v023 <- attr(dhsData2013$v023, "labels")
# Function to extract the admin1 names only
clean_admin1 <- function(label) {
words <- unlist(strsplit(label, " "))  # Split by space
if (length(words) >= 3) {
return(paste(words[2:(length(words)-1)], collapse = " "))  # Remove first and last word
} else {
return(words[2])  # If only two words, keep the second one
}
}
# Apply function to clean the labels
cleaned_labels <- sapply(names(labels_v023), clean_admin1)
# Get unique admin1 names
unique_admin1 <- unique(cleaned_labels)
# Map old values to new values
new_label_map <- setNames(1:length(unique_admin1), unique_admin1)
# Create a lookup table for mapping original v023 values
old_to_new_map <- setNames(new_label_map[cleaned_labels], as.numeric(names(labels_v023)))
# Create a modified dataset with the updated v023 column
dhsData2013_modify <- dhsData2013 %>%
mutate(v023 = recode(v023, !!!old_to_new_map))
# Update the labels attribute
attr(dhsData2013_modify$v023, "labels") <- new_label_map
# Preserve other attributes
attr(dhsData2013_modify$v023, "label") <- "Admin1 regions"
attr(dhsData2013_modify$v023, "format.stata") <- "%8.0g"
# Check the structure of the modified dataset
str(dhsData2013_modify$v023)
