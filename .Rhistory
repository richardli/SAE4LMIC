}
bh_2016_dhs <- convert_MICS_to_DHS_admin1(bh_2016)
bh_2021_dhs <- convert_MICS_to_DHS_admin1(bh_2021)
Person_month_MICS2016 <- getBirths(
data = bh_2016_dhs,
surveyyear = 2016,
month.cut = c(1),
year.cut = seq(1990, 2020, by = 5),
strata = c("v024","v025"),
compact = FALSE
)
Person_month_MICS2021 <- getBirths(
data = bh_2021_dhs,
surveyyear = 2021,
month.cut = c(1),
year.cut = seq(1990, 2020, by = 5),
strata = c("v024","v025"),
compact = FALSE
)
# Function to convert labelled v023 to character format like DHS
convert_v023_to_character <- function(data) {
if ("v023" %in% colnames(data)) {
data <- data %>%
mutate(v023 = as.character(haven::as_factor(v023)))  # Convert labelled numeric to character labels
}
return(data)
}
# Apply conversion to MICS datasets
Person_month_MICS2016 <- convert_v023_to_character(Person_month_MICS2016)
Person_month_MICS2021 <- convert_v023_to_character(Person_month_MICS2021)
# # Verify consistency
# str(Person_month_MICS2016$v023)
# str(Person_month_MICS2021$v023)
# Store them in a named list
MyData <- list("2008" = Person_month_DHS2008_admin1, "2013" = Person_month_DHS2013_admin1, "2018" = Person_month_DHS2018_admin1, "2016" = Person_month_MICS2016, "2021" = Person_month_MICS2021)
MyDataNMR <- MyData
for(i in 1:length(MyData)){
MyDataNMR[[i]] <- subset(MyData[[i]], age == "0")
}
# for multiple surveys, we combine the person-month records into a list and use the
periods <- c("90-94", "95-99", "00-04", "05-09", "10-14", "15-19")
#obtain the survey specific direct estimates
directNMR <- getDirectList(births = MyDataNMR, years = periods,
regionVar = "v023", timeVar = "time",
clusterVar = "~v001 + v002", ageVar = "age",
weightsVar = "v005")
