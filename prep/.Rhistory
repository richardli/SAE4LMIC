test_one <- function(code, FUN) {
cat("\n=========================================================\n")
cat("Testing:", code, "\n")
res <- list(code = code, smoke = "FAIL", direct = NA_real_, api = NA_real_)
# ---- 1) data processing (smoke test) ----
data <- tryCatch({
dhsData <- getDHSdata(country = "Zambia", indicator = code, year = 2018)
d <- getDHSindicator(dhsData, indicator = NULL, FUN = FUN)
stopifnot(is.data.frame(d), "value" %in% names(d), sum(!is.na(d$value)) > 0)
cat("  [process] PASS - rows:", nrow(d),
"| non-NA:", sum(!is.na(d$value)), "\n")
res$smoke <<- "PASS"
d
}, error = function(e) { cat("  [process] FAIL:", conditionMessage(e), "\n"); NULL })
if (is.null(data)) return(res)
# ---- 2) national direct estimate (admin = 0) ----
res$direct <- tryCatch({
natl <- directEST(data = data, cluster.info = cluster.info, admin = 0)
est  <- 100 * natl$direct.est[1]                 # proportion -> percent
lo   <- 100 * natl$direct.lower[1]
hi   <- 100 * natl$direct.upper[1]
cat(sprintf("  [direct]  national est: %.2f%%  (95%% CI %.2f - %.2f)\n", est, lo, hi))
est
}, error = function(e) { cat("  [direct]  ERROR:", conditionMessage(e), "\n"); NA_real_ })
# ---- 3) DHS published national value from the API ----
res$api <- tryCatch({
tab <- get_api_table(country = "ZM", survey = "ZM2018DHS",
indicator = code, admin = 0, simplify = TRUE)
if (is.null(tab) || nrow(tab) == 0 || !("Value" %in% names(tab))) {
cat("  [api]     no API value for", code, "(code may not be a DHS API id)\n")
NA_real_
} else {
v <- as.numeric(tab$Value[1])
cat(sprintf("  [api]     DHS published: %.2f%%\n", v))
v
}
}, error = function(e) { cat("  [api]     ERROR:", conditionMessage(e), "\n"); NA_real_ })
# ---- 4) compare ----
if (!is.na(res$direct) && !is.na(res$api))
cat(sprintf("  [compare] direct - DHS = %+.2f pp\n", res$direct - res$api))
res
}
results <- lapply(names(recent), function(k) test_one(k, recent[[k]]))
cat("\n=========================================================\nSUMMARY\n")
print(do.call(rbind, lapply(results, function(r) data.frame(
indicator   = r$code,
process     = r$smoke,
direct_pct  = round(r$direct, 2),
dhs_api_pct = round(r$api, 2),
diff_pp     = round(r$direct - r$api, 2)
))), row.names = FALSE)
