mu_ht   = mu_ht, v_ht = v_ht,
mu_hj   = mu_hj, v_hj = v_hj,
n_f1    = length(s1),
mu_ht_f1 = f1["mu_ht"], v_ht_f1 = f1["v_ht"],
mu_hj_f1 = f1["mu_hj"], v_hj_f1 = f1["v_hj"],
n_f2    = length(s2),
mu_ht_f2 = f2["mu_ht"], v_ht_f2 = f2["v_ht"],
mu_hj_f2 = f2["mu_hj"], v_hj_f2 = f2["v_hj"]
)
}
# Run many replicates
B <- 100
out_list <- replicate(B, one_rep(eps = 0.5), simplify = FALSE)
out_list <- out_list[!sapply(out_list, is.null)]
out <- as.data.frame(do.call(rbind, out_list))
# Helper to summarize an estimator: bias, empirical var, mean of estimated var
summ <- function(est, vhat) {
est <- out[[est]]
vhat <- out[[vhat]]
c(
bias = mean(est - mu_true, na.rm = TRUE),
emp_var = var(est, na.rm = TRUE),
mean_vhat = mean(vhat, na.rm = TRUE)
)
}
mu_true <- unique(out$mu_true)[1]
# Summary table
tab <- rbind(
full_HT    = summ("mu_ht",    "v_ht"),
full_Hajek = summ("mu_hj",    "v_hj"),
fold1_HT   = summ("mu_ht_f1", "v_ht_f1"),
fold1_Hajek= summ("mu_hj_f1", "v_hj_f1"),
fold2_HT   = summ("mu_ht_f2", "v_ht_f2"),
fold2_Hajek= summ("mu_hj_f2", "v_hj_f2")
)
# One replicate: sample -> compute HT/Hajek mean + var; then split eps=1/2 -> same
one_rep <- function(eps = 0.5) {
I <- rbinom(N, 1, pi)
s <- which(I == 1)
if (length(s) < 2) return(NULL)  # extremely rare, but keep safe
# ---------- Full sample ----------
w  <- 1 / pi[s]
# HT mean (assumes N known): (1/N) * sum(y/pi)
mu_ht <- sum(y[s] * w) / N
# Hajek mean (ratio): sum(w*y)/sum(w)
mu_hj <- sum(y[s] * w) / sum(w)
# Variance estimators under Poisson sampling:
# Var(HT mean) = Var(HT total)/N^2, with Var(HT total) est = sum I*(1-pi)/pi^2 * y^2
v_ht <- sum((1 - pi[s]) * (y[s]^2) / (pi[s]^2)) / (N^2)
# Var(Hajek mean) via linearization:
# Var(R) approx Var(HT total of z)/ (HT total of 1)^2, z = y - R
z   <- y[s] - mu_hj
v_hj <- sum((1 - pi[s]) * (z^2) / (pi[s]^2)) / (sum(w)^2)
# ---------- Split into two folds (eps = 1/2) ----------
# Assign each selected unit to fold1 with prob eps (so fold1 has inclusion prob eps*pi)
A <- rbinom(length(s), 1, eps)
s1 <- s[A == 1]
s2 <- s[A == 0]
calc_fold <- function(ss, peff) {
if (length(ss) < 2) return(c(mu_ht = NA, mu_hj = NA, v_ht = NA, v_hj = NA))
w_eff <- 1 / peff[ss]
mu_ht_f <- sum(y[ss] * w_eff) / N
mu_hj_f <- sum(y[ss] * w_eff) / sum(w_eff)
v_ht_f  <- sum((1 - peff[ss]) * (y[ss]^2) / (peff[ss]^2)) / (N^2)
zf      <- y[ss] - mu_hj_f
v_hj_f  <- sum((1 - peff[ss]) * (zf^2) / (peff[ss]^2)) / (sum(w_eff)^2)
c(mu_ht = mu_ht_f, mu_hj = mu_hj_f, v_ht = v_ht_f, v_hj = v_hj_f)
}
p1 <- eps * pi
p2 <- (1 - eps) * pi
f1 <- calc_fold(s1, p1)
f2 <- calc_fold(s2, p2)
c(
mu_true = mu_true,
n_full  = length(s),
mu_ht   = mu_ht, v_ht = v_ht,
mu_hj   = mu_hj, v_hj = v_hj,
n_f1    = length(s1),
mu_ht_f1 = f1["mu_ht"], v_ht_f1 = f1["v_ht"],
mu_hj_f1 = f1["mu_hj"], v_hj_f1 = f1["v_hj"],
n_f2    = length(s2),
mu_ht_f2 = f2["mu_ht"], v_ht_f2 = f2["v_ht"],
mu_hj_f2 = f2["mu_hj"], v_hj_f2 = f2["v_hj"]
)
}
# Run many replicates
B <- 100
out_list <- replicate(B, one_rep(eps = 0.5), simplify = FALSE)
out_list <- out_list[!sapply(out_list, is.null)]
out <- as.data.frame(do.call(rbind, out_list))
out
# Helper to summarize an estimator: bias, empirical var, mean of estimated var
summ <- function(est, vhat) {
est <- out[[est]]
vhat <- out[[vhat]]
c(
bias = mean(est - mu_true, na.rm = TRUE),
emp_var = var(est, na.rm = TRUE),
mean_vhat = mean(vhat, na.rm = TRUE)
)
}
mu_true <- unique(out$mu_true)[1]
# Summary table
tab <- rbind(
full_HT    = summ("mu_ht",    "v_ht"),
full_Hajek = summ("mu_hj",    "v_hj"),
fold1_HT   = summ("mu_ht_f1", "v_ht_f1"),
fold1_Hajek= summ("mu_hj_f1", "v_hj_f1"),
fold2_HT   = summ("mu_ht_f2", "v_ht_f2"),
fold2_Hajek= summ("mu_hj_f2", "v_hj_f2")
)
