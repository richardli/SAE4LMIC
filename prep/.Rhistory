# ---------------------------------------------------------------------------
# Smoke test + national direct estimate vs. DHS published (API) value,
# for the 4 most recently added data-processing functions, Zambia 2018.
#
# Functions tested (most recent two feature commits):
#   CH_VACS_C_PN3  PCV3 vaccination            (KR)
#   CH_VACS_C_RT1  Rotavirus 1 vaccination     (KR)
#   HA_HIVP_B_HIV  HIV prevalence              (IR + MR + AR merge)
#   ML_PMAL_C_RDT  Malaria parasitemia via RDT (PR)
#
# Needs: network + a DHS account with Zambia 2018 access (rdhs prompts to log
#        in on the first getDHSdata() call if not already configured).
#
# Note: get_api_table() only returns a value when the indicator code is a real
#       DHS API indicator ID at national level. Custom/renamed codes may come
#       back empty - reported as "no API value", not a failure.
#
# Run:  source("/Users/qianyu/Dropbox/binary_code/pcg/indicator/test_recent_indicators_zambia2018.R")
# ---------------------------------------------------------------------------
# Load the package from its source tree (explicit path: this script lives
# outside the package, so "." won't point at the package root).
pkg_path <- "/Users/qianyu/Dropbox/binary_code/pcg/surveyPrev"
if (requireNamespace("devtools", quietly = TRUE)) {
devtools::load_all(pkg_path)
} else {
library(surveyPrev)
}
`%||%` <- function(a, b) if (is.null(a)) b else a
# ---- one-time setup: geography + cluster info (needed by directEST) ----
geo <- getDHSgeo(country = "Zambia", year = 2018)
data(ZambiaAdm1); data(ZambiaAdm2)
cluster.info <- clusterInfo(geo = geo,
poly.adm1 = ZambiaAdm1, poly.adm2 = ZambiaAdm2,
by.adm1 = "NAME_1", by.adm2 = "NAME_2")
# indicator code -> processing function (the 4 most recent additions)
recent <- list(
CH_VACS_C_PN3 = surveyPrev::CH_VACS_C_PN3,  # PCV3 vaccination (KR)
CH_VACS_C_RT1 = surveyPrev::CH_VACS_C_RT1,  # Rotavirus 1 vaccination (KR)
HA_HIVP_B_HIV = surveyPrev::HA_HIVP_B_HIV,  # HIV prevalence (IR + MR + AR)
ML_PMAL_C_RDT = surveyPrev::ML_PMAL_C_RDT   # Malaria parasitemia via RDT (PR)
)
